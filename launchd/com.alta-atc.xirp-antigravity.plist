<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for the xirp-antigravity LaunchAgent, installed by
  `xirp-antigravity install-watcher` into
  ~/Library/LaunchAgents/com.alta-atc.xirp-antigravity.plist with the
  placeholders below substituted for absolute paths on the current machine.
  It watches Xirp's Info.plist and re-applies the Antigravity harness patch
  whenever Xirp updates.

  Placeholders (filled in by bin/xirp-antigravity.js, not meant to be edited by hand):
    {{LABEL}}          reverse-DNS label, com.alta-atc.xirp-antigravity
    {{NODE_PATH}}       absolute path to the node executable running xirp-antigravity
    {{BIN_PATH}}        absolute path to bin/xirp-antigravity.js
    {{WATCH_PATH}}      path to Xirp's Contents/Info.plist to watch for changes
    {{LOG_PATH}}        stdout log path, ~/Library/Logs/xirp-antigravity.log
    {{ERR_LOG_PATH}}    stderr log path, ~/Library/Logs/xirp-antigravity.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>{{LABEL}}</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{NODE_PATH}}</string>
    <string>{{BIN_PATH}}</string>
    <string>apply</string>
    <string>--if-needed</string>
  </array>
  <key>WatchPaths</key>
  <array>
    <string>{{WATCH_PATH}}</string>
  </array>
  <key>StandardOutPath</key>
  <string>{{LOG_PATH}}</string>
  <key>StandardErrorPath</key>
  <string>{{ERR_LOG_PATH}}</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
